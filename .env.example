# Để trống = dùng dữ liệu giả lập trong public/mock (lấy từ website hiện tại của trường).
# Điền URL API khi backend của trường sẵn sàng, ví dụ: https://api.trungcapnhanlucquocte.vn/api/
VITE_API_URL=
VITE_APP_URL=https://trungcapnhanlucquocte.vn

# Ép dùng dữ liệu giả lập kể cả khi đã có VITE_API_URL (để thử nghiệm): VITE_USE_MOCK=1
# VITE_USE_MOCK=0

# Key cho link https://<domain>/sitemap/refresh?key=... (chỉ cần set trên EasyPanel)
SITEMAP_KEY=DEV_FE
