# VITE_API_URL là bắt buộc — website không còn dữ liệu giả lập nào.
# Có giá trị = dùng API thật. Nhớ /api ở cuối.
VITE_API_URL=https://truongdaynghe-api.x2ldh2.easypanel.host/api
VITE_APP_URL=https://trungcapnhanlucquocte.vn

# Host chứa ảnh, ngoài tên miền web và API (bucket lưu ảnh upload từ trang quản trị).
# Nhiều host thì phân tách bằng dấu phẩy. Thiếu khai là ảnh trong bài bị gỡ.
VITE_IMAGE_HOSTS=truongdaynghe-rustfs.x2ldh2.easypanel.host


# Key cho link https://<domain>/sitemap/refresh?key=... (chỉ cần set trên EasyPanel)
SITEMAP_KEY=DEV_FE
