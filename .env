# Backend của trường — nguồn dữ liệu duy nhất của website.
# Phải có /api ở cuối: route nằm dưới /api/client/* và /api/admin/*.
VITE_API_URL=https://truongdaynghe-api.x2ldh2.easypanel.host/api
VITE_APP_URL=https://trungcapnhanlucquocte.vn

# Host chứa ảnh, ngoài tên miền web và API. Ảnh nhà trường upload qua trang quản trị nằm trên
# bucket này, KHÔNG phải trên tên miền web. Thiếu khai ở đây thì dropForeignImages (src/utils/html.ts)
# coi chúng là ảnh mượn của site khác và gỡ sạch khỏi bài.
VITE_IMAGE_HOSTS=truongdaynghe-rustfs.x2ldh2.easypanel.host

# Key cho link https://<domain>/sitemap/refresh?key=... (chỉ cần set trên EasyPanel)
SITEMAP_KEY=DEV_FE
